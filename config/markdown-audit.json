{
  "classification_rules": [
    {
      "category": "embedded_upstream",
      "patterns": [
        "guider_ui/*/lvgl/**",
        "guider_ui/*/lvgl-simulator/**",
        "examples/esp-idf/08_bookesia/components/brookesia_core/**",
        "examples/esp-idf/components/pedrominatel__shtc3/*.md",
        "examples/esp-idf/components/pedrominatel__shtc3/examples/**"
      ]
    },
    {
      "category": "first_party_wrapper",
      "patterns": [
        "examples/esp-idf/components/**"
      ]
    }
  ],
  "bilingual_pairs": [
    {
      "english": "README.en.md",
      "chinese": "README.cn.md"
    }
  ],
  "pair_exempt_patterns": [
    ".github/pull_request_template.md"
  ],
  "language_link_exempt_patterns": [
    ".github/pull_request_template.md"
  ],
  "docs_only_allowed_patterns": [
    "assets/*.png",
    "assets/*.webp",
    "dimensions/*.pdf",
    "dimensions/*.dxf",
    "dimensions/*.stp",
    "schematic/*.pdf",
    "readme.txt"
  ],
  "homepage_pairs": [
    {
      "english": "README.md",
      "chinese": "README_ZH.md",
      "profile": "single-product"
    }
  ]
}
