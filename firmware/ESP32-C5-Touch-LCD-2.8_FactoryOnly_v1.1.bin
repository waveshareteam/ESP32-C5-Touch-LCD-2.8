<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WiFi Configuration</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 500px;
            margin: 0 auto;
            padding: 20px;
            background-color: #f5f5f5;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
        }
        .container {
            background-color: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.08);
        }
        .input-container {
            margin-bottom: 22px;
        }
        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #333;
            font-size: 15px;
        }
        input {
            width: 100%;
            padding: 11px 15px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            box-sizing: border-box;
            font-size: 16px;
            transition: border-color 0.3s;
        }
        input:focus {
            outline: none;
            border-color: #4d90fe;
            box-shadow: 0 0 0 3px rgba(77, 144, 254, 0.15);
        }
        .button-container {
            margin-top: 35px;
        }
        button {
            width: 100%;
            padding: 13px;
            background-color: #4d90fe;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.2s;
        }
        button:hover {
            background-color: #357ae8;
        }
        button:disabled {
            background-color: #e0e0e0;
            cursor: not-allowed;
            transform: none;
        }
        button:active:not(:disabled) {
            transform: scale(0.98);
        }
        .warning {
            color: #ff8c00;
            font-size: 13px;
            margin-top: 6px;
            display: none;
        }

        /* å¼¹çª—é®ç½©å±‚ */
        .popup-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(2px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .popup-overlay.show {
            opacity: 1;
            display: flex;
        }

        /* å¼¹çª—ä¸»ä½“ - ç»Ÿä¸€åœ†è§’ */
        .popup-box {
            background-color: white;
            width: 85%;
            max-width: 340px;
            border-radius: 16px; /* å¼¹çª—æ•´ä½“åœ†è§’ */
            padding: 28px 25px;
            text-align: center;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
            transform: translateY(20px);
            transition: transform 0.3s ease;
            overflow: hidden;
        }
        .popup-overlay.show .popup-box {
            transform: translateY(0);
        }

        /* æˆåŠŸå¼¹çª—ä¸“å±ç»¿è‰²å…ƒç´  */
        .popup-box.success {
            border-top: 5px solid #28a745; /* é¡¶éƒ¨ç»¿è‰²è£…é¥°æ¡ */
        }
        .popup-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%; /* å›¾æ ‡åœ†å½¢åœ†è§’ */
            margin: 0 auto 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: white;
        }
        .popup-icon.success {
            background-color: #28a745; /* æˆåŠŸå›¾æ ‡ç»¿è‰²èƒŒæ™¯ */
        }
        .popup-icon.error {
            background-color: #dc3545; /* é”™è¯¯å›¾æ ‡çº¢è‰²èƒŒæ™¯ */
        }

        .popup-title {
            font-size: 18px;
            font-weight: 600;
            color: #333;
            margin-bottom: 10px;
        }
        .popup-desc {
            font-size: 14px;
            color: #666;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        /* å¼¹çª—æŒ‰é’® - æˆåŠŸæŒ‰é’®ç»¿è‰²åœ†è§’ */
        .popup-btn {
            padding: 11px 28px;
            border-radius: 30px; /* æŒ‰é’®å¤§åœ†è§’ */
            border: none;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .popup-btn.success {
            background-color: #28a745;
            color: white;
        }
        .popup-btn.success:hover {
            background-color: #218838;
            box-shadow: 0 4px 12px rgba(40, 167, 69, 0.2);
        }
        .popup-btn.error {
            background-color: #dc3545;
            color: white;
        }
        .popup-btn.error:hover {
            background-color: #c82333;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.2);
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>WiFi Configuration</h1>
    </div>
    <div class="container">
        <div class="input-container">
            <label for="ssid">SSID</label>
            <input type="text" id="ssid" placeholder="Enter WiFi SSID" required>
            <div class="warning" id="ssidWarning">Please enter a valid SSID</div>
        </div>
        <div class="input-container">
            <label for="password">Password</label>
            <input type="password" id="password" placeholder="Enter WiFi Password">
            <div class="warning" id="passwordWarning">Password should be at least 8 characters</div>
        </div>
        <div class="button-container">
            <button id="btn1" onclick="sendWifiConfig()">Submit WiFi Config</button>
        </div>
    </div>

    <!-- è‡ªå®šä¹‰å¼¹çª— -->
    <div class="popup-overlay" id="popupOverlay">
        <div class="popup-box" id="popupBox">
            <div class="popup-icon" id="popupIcon"></div>
            <div class="popup-title" id="popupTitle"></div>
            <div class="popup-desc" id="popupDesc"></div>
            <button class="popup-btn" id="popupBtn" onclick="hidePopup()">OK</button>
        </div>
    </div>

    <script>
        // æ˜¾ç¤º/éšè—è¾“å…¥è­¦å‘Š
        function showWarning(elementId, show) {
            document.getElementById(elementId).style.display = show ? 'block' : 'none';
        }

        // æ˜¾ç¤ºè‡ªå®šä¹‰å¼¹çª—ï¼ˆåŒºåˆ†æˆåŠŸ/é”™è¯¯ï¼‰
        function showPopup(isSuccess) {
            const overlay = document.getElementById('popupOverlay');
            const box = document.getElementById('popupBox');
            const icon = document.getElementById('popupIcon');
            const title = document.getElementById('popupTitle');
            const desc = document.getElementById('popupDesc');
            const btn = document.getElementById('popupBtn');

            // æˆåŠŸå¼¹çª—ï¼šç»¿è‰²å…ƒç´ é…ç½®
            if (isSuccess) {
                box.className = 'popup-box success';
                icon.className = 'popup-icon success';
                icon.textContent = 'âœ“'; // æˆåŠŸå›¾æ ‡
                title.textContent = 'Configuration Success';
                desc.textContent = 'WiFi configuration has been submitted successfully.';
                btn.className = 'popup-btn success';
            } 
            // é”™è¯¯å¼¹çª—ï¼šçº¢è‰²å…ƒç´ é…ç½®
            else {
                box.className = 'popup-box';
                icon.className = 'popup-icon error';
                icon.textContent = 'âœ—'; // é”™è¯¯å›¾æ ‡
                title.textContent = 'Submission Failed';
                desc.textContent = 'Failed to submit WiFi config. Please try again later.';
                btn.className = 'popup-btn error';
            }

            // æ˜¾ç¤ºå¼¹çª—ï¼ˆå¸¦åŠ¨ç”»ï¼‰
            overlay.classList.add('show');
        }

        // éšè—å¼¹çª—
        function hidePopup() {
            const overlay = document.getElementById('popupOverlay');
            overlay.classList.remove('show');
        }

        // è¾“å…¥éªŒè¯
        function validateInputs(ssid, password) {
            let isValid = true;
            if (!ssid.trim()) {
                showWarning('ssidWarning', true);
                isValid = false;
            } else {
                showWarning('ssidWarning', false);
            }
            if (password && password.length < 8) {
                showWarning('passwordWarning', true);
                isValid = false;
            } else {
                showWarning('passwordWarning', false);
            }
            return isValid;
        }

        // å‘é€WiFié…ç½®
        function sendWifiConfig() {
            const ssid = document.getElementById('ssid').value;
            const password = document.getElementById('password').value;
            const btn = document.getElementById('btn1');

            if (!validateInputs(ssid, password)) return;

            // é˜²æ­¢é‡å¤æäº¤
            btn.disabled = true;
            btn.textContent = 'Submitting...';

            // æ„é€ JSONæ•°æ®
            const data = { ssid, password };
            const xhr = new XMLHttpRequest();
            xhr.open('POST', '/wifi_config', true);
            xhr.setRequestHeader('Content-Type', 'application/json');

            // å“åº”å¤„ç†
            xhr.onload = () => {
                btn.disabled = false;
                btn.textContent = 'Submit WiFi Config';
                // æ ¹æ®çŠ¶æ€ç æ˜¾ç¤ºå¯¹åº”å¼¹çª—
                showPopup(xhr.status >= 200 && xhr.status < 300);
            };

            // ç½‘ç»œé”™è¯¯å¤„ç†
            xhr.onerror = () => {
                btn.disabled = false;
                btn.textContent = 'Submit WiFi Config';
                showPopup(false);
            };

            xhr.send(JSON.stringify(data));
        }

        // å®æ—¶è¾“å…¥éªŒè¯
        document.getElementById('ssid').addEventListener('input', function() {
            if (this.value.trim()) showWarning('ssidWarning', false);
        });
        document.getElementById('password').addEventListener('input', function() {
            if (this.value.length >= 8) showWarning('passwordWarning', false);
        });
    </script>
</body>
